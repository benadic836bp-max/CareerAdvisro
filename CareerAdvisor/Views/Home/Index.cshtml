@model List<Skill>
<h3>Rate your skills</h3>
<p class="text-muted">0 = none, 1 = beginner, 5 = expert.</p>
<form asp-action="Recommend" method="post">
  @foreach (var group in Model.GroupBy(s => s.Category))
  {
    <div class="card mb-3"><div class="card-header fw-bold">@group.Key</div>
      <div class="card-body row g-3">
        @foreach (var s in group)
        {
          <div class="col-md-4">
            <label class="form-label">@s.Name</label>
            <select name="levels[@s.Id]" class="form-select">
              @for (int i = 0; i <= 5; i++) { <option value="@i">@i</option> }
            </select>
          </div>
        }
      </div>
    </div>
  }
  <button class="btn btn-primary btn-lg">Get recommendations</button>
</form>
